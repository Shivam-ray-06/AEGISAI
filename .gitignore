# ==============================================================================
# AEGISAI — Git Ignore Configuration
# ==============================================================================

# OS & Filesystem Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Secrets & Environment Variables
.env
.env.local
.env.*.local
*.pem
*.key

# Node.js & React Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Java Backend (Maven & Gradle)
backend/target/
backend/.flattened-pom.xml
*.class
*.jar
*.war
*.ear
*.nar
.mvn/wrapper/maven-wrapper.jar
.gradle/
build/

# Python & AI Engine
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
*.egg-info/
.installed.cfg
*.egg

# AI Pretrained Weights (Auto-downloaded by Ultralytics on first launch)
*.pt
yolov8*.pt
runs/

# Runtime Logs, Process IDs & Scratch Files
*.log
*.pid
storage/*.log
storage/*.pid
storage/thumbnails/debug/

# Heavy Video Storage (Keep directory structures via .gitkeep)
storage/uploads/*.mp4
storage/uploads/*.mov
storage/uploads/*.avi
storage/processed/*.mp4
storage/processed/*.raw.mp4
storage/processed/*.avi

# Keep essential report templates & schemas
!storage/uploads/.gitkeep
!storage/processed/.gitkeep
!storage/reports/.gitkeep
!storage/thumbnails/.gitkeep

# IDEs & Editors
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
*.sublime-workspace
*.sublime-project
