# ==============================================================================
# AEGISAI — Environment Configuration Template
# Copy this file to '.env' before running the platform:
#   cp .env.example .env
# ==============================================================================

# Application Service Ports
SERVER_PORT=8085
FRONTEND_PORT=5173
AI_SERVICE_PORT=8000

# Service Endpoints
AI_SERVICE_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8085/api/v1

# Security & API Secrets
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here_aegisai_2026
AEGISAI_API_KEY=aegis_sec_your_secure_api_key_here

# Database Configuration (PostgreSQL with automatic local H2 in-memory fallback)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aegisai
DB_USER=aegisai
DB_PASSWORD=aegisai_secure_pass_2026

# Storage Base Paths (Defaults to relative storage/ directory)
STORAGE_BASE_DIR=./storage
STORAGE_UPLOADS_DIR=./storage/uploads
STORAGE_PROCESSED_DIR=./storage/processed
STORAGE_REPORTS_DIR=./storage/reports
STORAGE_THUMBNAILS_DIR=./storage/thumbnails

# AI Engine & Computer Vision Settings
YOLO_MODEL=yolov8n.pt
DEVICE=mps          # Options: 'mps' (Apple Silicon), 'cuda' (Nvidia GPU), 'cpu'
CONF_THRESHOLD=0.25
IOU_THRESHOLD=0.45
TRACKER_TYPE=bytetrack.yaml
FRAME_SAMPLE_RATE=2
MAX_INFERENCE_WIDTH=640
