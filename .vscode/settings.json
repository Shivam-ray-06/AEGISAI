{
    "files.exclude": {
        "**/._*": true,
        "**/.git": true,
        "**/.DS_Store": true,
        "**/__pycache__": true
    },
    "search.exclude": {
        "**/._*": true,
        "**/node_modules": true,
        "**/bower_components": true,
        "**/*.code-search": true,
        "**/target": true
    },
    "java.compile.nullAnalysis.mode": "automatic",
    "java.configuration.updateBuildConfiguration": "interactive"
}